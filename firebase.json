{
  "hosting": {
    "public": "public",
    "rewrites": [
      {
        "source": "/admin/**",
        "function": "api3"
      }
    ]
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "src/config/sheduler.js",
        "src/config/batchScheduler.js",
        "src/config/delayCleanupScheduler.js"
      ],
      "runtime": "nodejs22"
    }
  ]
}