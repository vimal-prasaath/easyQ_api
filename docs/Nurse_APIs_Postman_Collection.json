            "description": "Nurse authentication related APIs"
        },
        {
            "name": "Nurse Management",
            "item": [
                {
                    "name": "Create Nurse",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_jwt_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"adminId\": \"{{admin_id}}\",\n  \"name\": \"Jane Nurse\",\n  \"email\": \"jane.nurse@example.com\",\n  \"mobileNumber\": \"9876543210\",\n  \"gender\": \"Female\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"qualification\": [\"B.Sc Nursing\", \"M.Sc Nursing\"],\n  \"serviceStartDate\": \"2020-01-01\",\n  \"hospitalId\": \"{{hospital_id}}\",\n  \"status\": \"Available\",\n  \"workingHours\": [\n    {\n      \"day\": \"Monday\",\n      \"date\": \"01/01/2024\",\n      \"available\": \"morning\",\n      \"timeSlots\": [\n        {\n          \"startTime\": \"09:00\",\n          \"endTime\": \"17:00\"\n        }\n      ]\n    }\n  ],\n  \"permissions\": {\n    \"profile\": { \"enabled\": true, \"viewOnly\": false },\n    \"tokenIssued\": { \"enabled\": true, \"viewOnly\": false }\n  }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/nurse/add",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
                                "add"
                            ]
                        },
                        "description": "Create new nurse (Admin only)"
                    },
                    "response": []
                },
                {
                    "name": "Get Nurse",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nurseId\": \"{{nurse_id}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/nurse/get",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
                                "get"
                            ]
                        },
                        "description": "Get specific nurse details"
                    },
                    "response": []
                },
                {
                    "name": "Update Nurse",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nurseId\": \"{{nurse_id}}\",\n  \"name\": \"Jane Smith Nurse\",\n  \"status\": \"On Duty\",\n  \"workingHours\": [\n    {\n      \"day\": \"Monday\",\n      \"date\": \"01/01/2024\",\n      \"available\": \"morning\",\n      \"timeSlots\": [\n        {\n          \"startTime\": \"08:00\",\n          \"endTime\": \"16:00\"\n        }\n      ]\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/nurse/update",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
                                "update"
                            ]
                        },
                        "description": "Update nurse information"
                    },
                    "response": []
                },
                {
                    "name": "Delete Nurse",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_jwt_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nurseId\": \"{{nurse_id}}\",\n  \"adminId\": \"{{admin_id}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/nurse/delete",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
                                "delete"
                            ]
                        },
                        "description": "Delete nurse (Admin only)"
                    },
                    "response": []
                },
                {
                    "name": "Get All Nurses by Hospital",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/nurse/all/{{hospital_id}}?page=1&limit=10&status=Available&search=Jane",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
                                "all",
                                "{{hospital_id}}"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "status",
                                    "value": "Available"
                                },
                                {
                                    "key": "search",
                                    "value": "Jane"
                                }
                            ]
                        },
                        "description": "Get all nurses for a specific hospital with optional filtering"
                    },
                    "response": []
                }
            ],
            "description": "Nurse CRUD operations"
