        {
            "name": "Image Management",
            "item": [
                {
                    "name": "Upload Nurse Image",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_jwt_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "PUT",
                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "adminId",
                                    "value": "{{admin_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "nurseId",
                                    "value": "{{nurse_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": []
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/nurse/upload-image",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
                                "upload-image"
                            ]
                        },
                        "description": "Upload nurse profile image (Admin only)"
                    },
                    "response": []
                },
                {
                    "name": "Update Nurse Image URL",
                    "request": {
                        "auth": {
