{
    "info": {
        "name": "EasyQ Nurse APIs",
        "description": "Complete collection of Nurse APIs for EasyQ system including authentication, CRUD operations, and image management",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "version": "1.0.0"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{jwt_token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000/api",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "admin_jwt_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "nurse_id",
            "value": "N0001",
            "type": "string"
        },
        {
            "key": "hospital_id",
            "value": "H0001",
            "type": "string"
        },
        {
            "key": "admin_id",
            "value": "A0001",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Nurse Authentication",
            "item": [
                {
                    "name": "Nurse Signup",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"nurse@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/nurse/signup",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
                                "signup"
                            ]
                        },
                        "description": "Complete nurse registration with password setup"
                    },
                    "response": []
                },
                {
                    "name": "Nurse Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    if (response.success && response.data.token) {",
                                    "        pm.collectionVariables.set('jwt_token', response.data.token);",
                                    "        pm.collectionVariables.set('nurse_id', response.data.nurse.nurseId);",
                                    "        console.log('JWT Token saved:', response.data.token);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"nurse@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/nurse/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
                                "login"
                            ]
                        },
                        "description": "Authenticate nurse and get JWT token"
