                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"adminId\": \"{{admin_id}}\",\n  \"nurseId\": \"{{nurse_id}}\",\n  \"fileUrl\": \"https://example.com/nurse-image.jpg\",\n  \"fileName\": \"nurse-image.jpg\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/nurse/update-image-url",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "nurse",
