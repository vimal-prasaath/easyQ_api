    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set default values if not already set",
                    "if (!pm.collectionVariables.get('base_url')) {",
                    "    pm.collectionVariables.set('base_url', 'http://localhost:3000/api');",
                    "}",
                    "",
                    "// Log current variables",
                    "console.log('Base URL:', pm.collectionVariables.get('base_url'));",
                    "console.log('JWT Token:', pm.collectionVariables.get('jwt_token') ? 'Set' : 'Not Set');",
                    "console.log('Admin JWT Token:', pm.collectionVariables.get('admin_jwt_token') ? 'Set' : 'Not Set');"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Global test script for all requests",
                    "pm.test('Response time is less than 5000ms', function () {",
                    "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                    "});",
                    "",
                    "pm.test('Response has success field', function () {",
                    "    const response = pm.response.json();",
                    "    pm.expect(response).to.have.property('success');",
                    "});",
                    "",
                    "// Log response for debugging",
                    "console.log('Response Status:', pm.response.status);",
                    "console.log('Response Body:', pm.response.text());"
                ]
            }
        }
    ]
