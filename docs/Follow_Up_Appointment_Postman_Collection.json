                {
                    "name": "Create Follow-up Appointment",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has success status\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql(\"success\");",
                                    "});",
                                    "",
                                    "pm.test(\"Response contains follow-up appointment data\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.have.property(\"appointmentId\");",
                                    "    pm.expect(jsonData.data).to.have.property(\"followUp\");",
                                    "    pm.expect(jsonData.data.followUp.isFollowUp).to.be.true;",
                                    "});",
                                    "",
                                    "// Store appointment ID for other tests",
                                    "if (pm.response.code === 201) {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.environment.set(\"follow_up_appointment_id\", jsonData.data.appointmentId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"patientId\": \"{{patient_id}}\",\n  \"doctorId\": \"{{doctor_id}}\",\n  \"hospitalId\": \"{{hospital_id}}\",\n  \"appointmentDate\": \"{{follow_up_date}}\",\n  \"appointmentTime\": \"10:00\",\n  \"followUpReason\": \"Blood test results review\",\n  \"createdBy\": \"doctor\",\n  \"createdById\": \"{{doctor_id}}\",\n  \"parentAppointmentId\": \"{{parent_appointment_id}}\",\n  \"consultationType\": \"Follow-up\",\n  \"notes\": \"Follow-up for blood test results\"\n}"
                        },
