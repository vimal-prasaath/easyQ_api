                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"patientId\": \"P0001\",\n  \"doctorId\": \"D0001\",\n  \"hospitalId\": \"H0001\",\n  \"appointmentDate\": \"2024-01-22\",\n  \"appointmentTime\": \"14:00\",\n  \"patientAddress\": {\n    \"addressName\": \"Home\",\n    \"origin\": {\n      \"lat\": 12.9716,\n      \"lng\": 77.5946\n    },\n    \"fullAddress\": \"123 Main Street, Bangalore, Karnataka, India\"\n  },\n  \"reasonForAppointment\": \"Regular checkup\",\n  \"appointmentType\": \"Consultation\",\n  \"status\": \"Scheduled\",\n  \"paymentStatus\": \"Paid\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/appointment",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "appointment"
                            ]
                        },
                        "description": "Create a new appointment with full address information"
                    },
                    "response": []
                }
            ]
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set random UUID for session tokens",
                    "pm.globals.set('randomUUID', pm.variables.replaceIn('{{$randomUUID}}'));"
                ]
            }
        }
    ]
}