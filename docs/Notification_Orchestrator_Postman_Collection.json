{
    "info": {
        "name": "Notification Orchestrator APIs",
        "description": "Complete collection of Notification Orchestrator APIs for testing FCM notifications, batch orchestration, and location services",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "version": "1.0.0"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Google Maps Integration",
            "description": "APIs for ETA calculation and Places autocomplete",
            "item": [
                {
                    "name": "Calculate ETA",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"origin\": {\n    \"lat\": 12.9716,\n    \"lng\": 77.5946\n  },\n  \"destination\": {\n    \"lat\": 12.9352,\n    \"lng\": 77.6245\n  },\n  \"mode\": \"driving\",\n  \"departureTime\": \"now\",\n  \"includePolyline\": true,\n  \"includeRaw\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/orchestrator/eta",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "orchestrator",
                                "eta"
                            ]
                        },
                        "description": "Calculate ETA and distance between two points using Google Maps Directions API"
                    },
                    "response": []
                },
                {
                    "name": "Places Autocomplete",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"input\": \"St. John Hospital\",\n  \"sessionToken\": \"{{$randomUUID}}\",\n  \"locationBias\": {\n    \"lat\": 12.9716,\n    \"lng\": 77.5946\n  },\n  \"radiusMeters\": 50000,\n  \"country\": \"IN\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/orchestrator/places/autocomplete",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "orchestrator",
                                "places",
                                "autocomplete"
                            ]
                        },
                        "description": "Get place suggestions with coordinates for address autocomplete"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "User Address Management",
            "description": "APIs for managing user addresses with coordinates",
            "item": [
                {
                    "name": "Add New Address",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"userId\": \"P0001\",\n  \"addressName\": \"Home\",\n  \"origin\": {\n    \"lat\": 12.9716,\n    \"lng\": 77.5946\n  },\n  \"fullAddress\": \"123 Main Street, Bangalore, Karnataka, India\",\n  \"isDefault\": true\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/user/address",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "user",
                                "address"
                            ]
                        },
                        "description": "Add a new address to user's address list"
                    },
                    "response": []
                },
                {
                    "name": "Get All User Addresses",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/user/address/P0001",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "user",
                                "address",
                                "P0001"
                            ]
                        },
                        "description": "Retrieve all addresses for a user"
                    },
                    "response": []
                },
                {
                    "name": "Update Specific Address",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"addressName\": \"Updated Home\",\n  \"origin\": {\n    \"lat\": 12.9800,\n    \"lng\": 77.6000\n  },\n  \"fullAddress\": \"Updated address\",\n  \"isDefault\": true\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/user/address/P0001/{{address_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "user",
                                "address",
                                "P0001",
                                "{{address_id}}"
                            ]
                        },
                        "description": "Update a specific address for a user"
                    },
                    "response": []
                },
                {
                    "name": "Delete Address",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/user/address/P0001/{{address_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "user",
                                "address",
                                "P0001",
                                "{{address_id}}"
                            ]
                        },
                        "description": "Delete a specific address for a user"
                    },
                    "response": []
                }
            ]
        },
        {
