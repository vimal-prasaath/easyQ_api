                        "description": "Create a new appointment with patient address for ETA calculations"
                    },
                    "response": []
                },
                {
                    "name": "Create Appointment with Full Address",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
