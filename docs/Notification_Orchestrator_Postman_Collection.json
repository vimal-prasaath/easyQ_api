                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"patientId\": \"P0001\",\n  \"doctorId\": \"D0001\",\n  \"hospitalId\": \"H0001\",\n  \"appointmentDate\": \"2024-01-22\",\n  \"appointmentTime\": \"14:00\",\n  \"patientAddress\": {\n    \"addressId\": \"uuid-home-address\"\n  },\n  \"reasonForAppointment\": \"Regular checkup\",\n  \"appointmentType\": \"Consultation\",\n  \"status\": \"Scheduled\",\n  \"paymentStatus\": \"Paid\"\n}"
                        },
                        "url": {
