                        "description": "Migrate existing appointments to add token numbers"
                    },
                    "response": []
                },
                {
                    "name": "Get Token Statistics",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/token/stats/D0001",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
