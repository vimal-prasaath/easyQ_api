                    "name": "Advance to Next Batch",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"doctorId\": \"D0001\",\n  \"appointmentDate\": \"2024-01-22\",\n  \"appointmentTime\": \"14:00\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/orchestrator/batch/advance",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "orchestrator",
                                "batch",
                                "advance"
                            ]
                        },
                        "description": "Manually advance to the next batch for a specific doctor and time slot"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "FCM Token Management",
            "description": "APIs for managing FCM tokens and sending test notifications",
            "item": [
                {
                    "name": "Send Test Notification",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"userId\": \"P0001\",\n  \"title\": \"Test Notification\",\n  \"body\": \"This is a test notification from the orchestrator\",\n  \"data\": {\n    \"type\": \"test\",\n    \"timestamp\": \"{{$timestamp}}\"\n  },\n  \"actions\": [\n    {\n      \"action\": \"yes\",\n      \"title\": \"Yes\"\n    },\n    {\n      \"action\": \"no\",\n      \"title\": \"No\"\n    }\n  ],\n  \"category\": \"test_category\",\n  \"dataOnly\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/fcm/test",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "fcm",
                                "test"
                            ]
                        },
                        "description": "Send a test FCM notification with optional actions and category"
                    },
                    "response": []
                }
            ]
        },
        {
