                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"patientId\": \"P0001\",\n  \"appointmentId\": \"12345\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/orchestrator/notifications/2hour-reminder",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "orchestrator",
                                "notifications",
                                "2hour-reminder"
                            ]
                        },
                        "description": "Manually trigger a 2-hour reminder notification"
                    },
                    "response": []
                },
                {
                    "name": "Send Location-Based Notification",
                    "request": {
                        "method": "POST",
