                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Doctor Delay Management",
            "description": "APIs for managing doctor delays and availability",
            "item": [
                {
                    "name": "Set Doctor Delay",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"doctorId\": \"D0001\",\n  \"date\": \"2024-01-22\",\n  \"startTime\": \"14:00\",\n  \"durationMinutes\": 30,\n  \"reason\": \"Emergency case in progress\",\n  \"createdBy\": \"admin\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/doctor/delay",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "doctor",
                                "delay"
                            ]
                        },
                        "description": "Set a delay for a doctor at a specific time"
                    },
                    "response": []
                },
                {
                    "name": "Get Doctor Delays",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/doctor/delay/D0001?date=2024-01-22",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "doctor",
                                "delay",
                                "D0001"
                            ],
                            "query": [
                                {
                                    "key": "date",
                                    "value": "2024-01-22"
                                }
                            ]
                        },
                        "description": "Get active delays for a doctor on a specific date"
                    },
                    "response": []
                },
                {
                    "name": "Clear Doctor Delays",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/doctor/delay/D0001?date=2024-01-22",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "doctor",
                                "delay",
                                "D0001"
                            ],
                            "query": [
                                {
                                    "key": "date",
                                    "value": "2024-01-22"
                                }
                            ]
                        },
                        "description": "Clear all delays for a doctor on a specific date"
                    },
                    "response": []
                },
                {
                    "name": "Reset Doctor Availability",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/doctor/reset-availability",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "doctor",
                                "reset-availability"
                            ]
                        },
                        "description": "Reset availability for all doctors (clear all delays)"
                    },
                    "response": []
                },
                {
                    "name": "Get Adjusted Appointment Time",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/doctor/adjusted-time?doctorId=D0001&appointmentDate=2024-01-22&originalTime=14:00",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "doctor",
                                "adjusted-time"
                            ],
                            "query": [
                                {
                                    "key": "doctorId",
                                    "value": "D0001"
                                },
                                {
                                    "key": "appointmentDate",
                                    "value": "2024-01-22"
                                },
                                {
                                    "key": "originalTime",
                                    "value": "14:00"
                                }
                            ]
                        },
                        "description": "Get adjusted appointment time considering doctor delays"
                    },
                    "response": []
                }
            ]
        },
        {
