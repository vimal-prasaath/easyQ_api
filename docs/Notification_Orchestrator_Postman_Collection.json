                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"doctorId\": \"D0001\",\n  \"delayMinutes\": 30,\n  \"reason\": \"Emergency case in progress\",\n  \"date\": \"2024-01-22\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/orchestrator/notifications/doctor-delay",
