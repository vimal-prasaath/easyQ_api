                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"appointmentId\": \"12345\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/orchestrator/batch/checkin",
